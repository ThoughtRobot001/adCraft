{
  "name": "adcraft",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "render": "remotion render src/index.ts AdComposition out/ad.mp4",
    "remotion:preview": "remotion preview src/index.ts --port 3001",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@react-three/fiber": "^8.18.0",
    "@remotion/player": "4.0.525",
    "@remotion/three": "4.0.525",
    "@remotion/transitions": "4.0.525",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.7.0",
    "canvas-confetti": "^1.9.4",
    "express": "^5.2.1",
    "motion": "^13.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.525",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0",
    "vite": "^6.4.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.525",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3"
  }
}
